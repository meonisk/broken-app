# Одинаковые переводы строк независимо от ОС — иначе на Windows каждый файл
# выглядит изменённым целиком.
* text=auto eol=lf

*.rs   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.sh   text eol=lf
*.svg  text eol=lf

# Картинки не нормализуем.
*.png binary
